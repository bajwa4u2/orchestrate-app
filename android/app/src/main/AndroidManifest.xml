<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for all backend API traffic (api.orchestrateops.com), Google
         sign-in, and url_launcher. The Flutter template only declares INTERNET
         in the debug/profile manifests, which do NOT merge into release builds;
         without this line the release AAB has no network access. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="Orchestrate"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- ANDROID APP LINKS - orchestrateops.com public routes.
                 SCOPED, NOT BLANKET. The host is declared per PATH rather than
                 as a bare host, because a bare host claims every URL on the
                 domain including /app/* operator surfaces and anything added
                 later. The list below is exactly the set the public web
                 acquisition rail treats as eligible, so what the web offers to
                 continue in the app and what the app is allowed to claim are
                 the same set by construction.

                 Verification requires https://orchestrateops.com/.well-known/
                 assetlinks.json to answer with JSON. It previously answered
                 with the SPA's index.html at HTTP 200, which cannot verify. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/product" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/how-it-works" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/ai-governed-revenue" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/lead-sourcing" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/trust-compliance" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/pricing" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/about" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/contact" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/terms" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/privacy" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/legal/terms" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/legal/privacy" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/why-orchestrate" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/how-orchestrate-operates" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/trust-architecture" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/for-evaluators" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/security-evaluation" />
                <data android:scheme="https" android:host="orchestrateops.com" android:path="/faq" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
